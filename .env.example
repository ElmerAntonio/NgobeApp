# Copia este archivo a .env y completa los valores con los de tu proyecto Supabase.
# Panel de Supabase: Project Settings -> API

# URL del proyecto Supabase (ej: https://xxxxx.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=

# Clave anónima (anon/public) de Supabase. Segura para el cliente móvil.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# URL base del backend (Express). Por defecto usa localhost en desarrollo.
EXPO_PUBLIC_API_URL=http://localhost:3001/api
