# Copia este archivo a .env y completa los valores con los de tu proyecto Supabase.
# Panel de Supabase: Project Settings -> API

# URL del proyecto Supabase (ej: https://xxxxx.supabase.co)
SUPABASE_URL=

# Clave anónima (anon/public). El backend la usa para operar en nombre del usuario autenticado (RLS aplicado).
SUPABASE_ANON_KEY=

# Clave de servicio (service_role). NUNCA la expongas al cliente móvil.
# Solo se usa para operaciones administrativas (ej: eliminar cuentas de auth.users).
SUPABASE_SERVICE_ROLE_KEY=

# Clave de la API de Anthropic (Claude), para las futuras funciones de IA.
ANTHROPIC_API_KEY=

# Orígenes permitidos para CORS, separados por coma (ej: http://localhost:8081,https://miapp.pa)
ALLOWED_ORIGINS=

# Puerto en el que corre el servidor Express (opcional, por defecto 3001)
PORT=3001

# Entorno de ejecución (development | production)
NODE_ENV=development
